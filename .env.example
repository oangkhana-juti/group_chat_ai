# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
ANTHROPIC_API_KEY=your_api_key_here
AI_MODEL=claude-sonnet-5-5
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio
PORT=3001
API_URL=http://localhost:3001
# Set this to the deployed backend origin when building the static site
VITE_API_URL=
# ตั้งเป็น true ถ้าใช้ DB บนคลาวด์ที่บังคับ SSL (เช่น Render, Neon)
PGSSL=true
